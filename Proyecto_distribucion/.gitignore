# Carpeta donde Mix deja los archivos compilados.
/_build/

# Archivos que genera "mix test --cover".
/cover/

# Carpeta donde Mix descarga las dependencias.
/deps/

# Documentacion que generan ExDoc y otras dependencias.
/doc/

# Archivos temporales, por ejemplo los de las pruebas.
/tmp/

# Volcado que deja la VM si se cae.
erl_crash.dump
